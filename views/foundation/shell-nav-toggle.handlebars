<button
  type="button"
  class="mc-shell-nav-toggle mc-button"
  data-variant="ghost"
  data-mc-nav-toggle
  aria-controls="mc-shell-primary-nav"
  aria-expanded="false"
  aria-label="{{ariaLabel}}"
>
  {{#if iconClass}}<i class="{{iconClass}}" aria-hidden="true"></i>{{/if}}
  <span>{{label}}</span>
</button>
