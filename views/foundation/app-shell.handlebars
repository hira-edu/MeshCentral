<div
  class="mc-app-shell o-shell"
  data-mc-shell="app"
  data-mc-nav-open="{{#if shell.primaryNavOpen}}true{{else}}false{{/if}}"
  data-mc-route="{{route.id}}"
  data-mc-route-group="{{route.group}}"
  data-mc-theme="{{theme}}"
  data-mc-density="{{density}}"
>
  <button
    type="button"
    class="mc-app-shell__nav-scrim"
    data-mc-shell-nav-overlay
    hidden
    aria-hidden="true"
    tabindex="-1"
  ></button>

  <aside class="mc-app-shell__sidebar" data-mc-shell-primary-nav data-mc-slot="shell-primary-nav">
    {{> foundation/primary-nav
      closeButtonLabel=primaryNavigation.closeButtonLabel
      footer=primaryNavigation.footer
      items=primaryNavigation.items
      label=primaryNavigation.label
      title=primaryNavigation.title
    }}
  </aside>

  <div class="mc-app-shell__main o-stack" style="--mc-stack-gap: var(--mc-space-20);">
    <header class="mc-app-shell__header mc-panel" data-mc-slot="shell-header">
      <div class="o-cluster" style="justify-content:space-between;">
        <div class="o-cluster" style="align-items:flex-start;">
          {{#if header.navToggle}}
            {{> foundation/shell-nav-toggle
              ariaLabel=header.navToggle.ariaLabel
              iconClass=header.navToggle.iconClass
              label=header.navToggle.label
            }}
          {{/if}}
          <div class="o-stack" style="--mc-stack-gap: var(--mc-space-4);">
            <p class="mc-badge">{{header.badge}}</p>
            <h1>{{header.title}}</h1>
            {{#if header.subtitle}}<p>{{header.subtitle}}</p>{{/if}}
          </div>
        </div>
        <div class="o-cluster" data-mc-slot="shell-header-actions">
          {{#if header.chrome}}
            {{> foundation/shell-header-actions
              extraActions=header.chrome.extraActions
              notifications=header.chrome.notifications
              userMenu=header.chrome.userMenu
            }}
          {{else}}
            {{{header.actions}}}
          {{/if}}
        </div>
      </div>
    </header>

    <nav class="mc-app-shell__workspace-nav" aria-label="Workspace navigation" data-mc-slot="shell-workspace-nav">
      {{> foundation/workspace-subnav items=workspaceNavigation activeRouteId=route.id}}
    </nav>

    <div class="o-sidebar-layout" data-mc-slot="shell-workspace">
      <main class="mc-app-shell__content" id="mc-main-content" tabindex="-1">
        {{#if @partial-block}}
          {{> @partial-block}}
        {{else}}
          {{{content}}}
        {{/if}}
      </main>

      <aside class="mc-app-shell__context" data-mc-slot="shell-context-panel">
        {{{contextPanel}}}
      </aside>
    </div>
  </div>
</div>
