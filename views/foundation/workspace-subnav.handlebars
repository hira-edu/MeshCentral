{{#if items}}
  <div class="mc-toolbar" data-mc-workspace-nav>
    <div class="o-cluster">
      {{#each items}}
        {{#unless hidden}}
          <a
            class="mc-button"
            data-variant="{{#if isActive}}primary{{else}}ghost{{/if}}"
            data-mc-route="{{routeId}}"
            data-mc-nav-kind="workspace"
            data-mc-dom-id="{{domId}}"
            href="{{#if href}}{{href}}{{else}}#{{/if}}"
            {{#if isActive}}aria-current="page"{{/if}}
          >
            {{label}}
          </a>
        {{/unless}}
      {{/each}}
    </div>

    <div class="o-cluster" data-mc-slot="workspace-nav-actions">
      {{{actions}}}
    </div>
  </div>
{{/if}}
