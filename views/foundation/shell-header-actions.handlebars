<div class="mc-shell-header-actions o-cluster" data-mc-slot="shell-header-chrome">
  {{#if notifications}}
    {{> foundation/shell-notification-center
      content=notifications.content
      count=notifications.count
      panelId=notifications.panelId
      panelLabel=notifications.panelLabel
      triggerContent=notifications.triggerContent
    }}
  {{/if}}

  {{#if userMenu}}
    {{> foundation/shell-user-menu
      menuContent=userMenu.menuContent
      menuId=userMenu.menuId
      triggerContent=userMenu.triggerContent
      uiSettings=userMenu.uiSettings
    }}
  {{/if}}

  {{{extraActions}}}
</div>
