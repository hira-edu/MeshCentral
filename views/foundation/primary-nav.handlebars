<nav id="mc-shell-primary-nav" class="mc-primary-nav mc-panel" aria-label="{{#if label}}{{label}}{{else}}Primary navigation{{/if}}">
  <div class="mc-primary-nav__header">
    <h2 class="mc-primary-nav__title">{{#if title}}{{title}}{{else}}Navigation{{/if}}</h2>
    <button
      type="button"
      class="mc-primary-nav__close mc-button"
      data-variant="ghost"
      data-mc-nav-close
      aria-controls="mc-shell-primary-nav"
      aria-label="{{#if closeButtonLabel}}{{closeButtonLabel}}{{else}}Close navigation{{/if}}"
    >
      <i class="fa-solid fa-xmark" aria-hidden="true"></i>
      <span>{{#if closeButtonLabel}}{{closeButtonLabel}}{{else}}Close navigation{{/if}}</span>
    </button>
  </div>

  <ul class="o-stack" style="--mc-stack-gap: var(--mc-space-8); list-style:none; padding:0; margin:0;">
    {{#each items}}
      {{#unless hidden}}
        <li>
          <a
            class="mc-button"
            data-variant="{{#if isActive}}primary{{else}}ghost{{/if}}"
            data-mc-route="{{routeId}}"
            data-mc-nav-kind="primary"
            data-mc-dom-id="{{domId}}"
            href="{{#if href}}{{href}}{{else}}#{{/if}}"
            {{#if isActive}}aria-current="page"{{/if}}
          >
            {{#if iconClass}}<i class="{{iconClass}}" aria-hidden="true"></i>{{/if}}
            <span>{{label}}</span>
          </a>
        </li>
      {{/unless}}
    {{/each}}
  </ul>

  <div data-mc-slot="shell-nav-footer">
    {{{footer}}}
  </div>
</nav>
