<div class="mc-shell-notification-center" data-mc-shell-notifications>
  <button
    type="button"
    class="mc-shell-notification-center__trigger"
    data-mc-notification-trigger
    aria-controls="{{panelId}}"
    aria-expanded="false"
  >
    {{{triggerContent}}}
    {{#if count}}
      <span class="mc-shell-notification-center__badge">{{count}}</span>
    {{/if}}
  </button>

  <section
    id="{{panelId}}"
    class="mc-shell-notification-center__panel mc-panel"
    data-mc-notification-panel
    hidden
    aria-hidden="true"
    aria-label="{{panelLabel}}"
  >
    {{#if @partial-block}}
      {{> @partial-block}}
    {{else}}
      {{{content}}}
    {{/if}}
  </section>
</div>
