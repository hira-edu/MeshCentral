{
  "name": "meshcentral-deploy",
  "version": "0.1.0",
  "private": true,
  "description": "Deployment wrapper: installs the fork package built from the repository root (npm run pack) with the production dependency pins",
  "scripts": {
    "pack": "node scripts/pack.js",
    "regenerate": "node scripts/regenerate.js",
    "check:generated": "node scripts/regenerate.js --check",
    "test": "node --test",
    "start": "node node_modules/meshcentral/meshcentral.js",
    "start:dev": "NODE_ENV=development node node_modules/meshcentral/meshcentral.js",
    "postinstall": "node -e \"try{require('fs').mkdirSync('meshcentral-data',{recursive:true})}catch(e){}\""
  },
  "dependencies": {
    "@mongodb-js/saslprep": "1.3.1",
    "acme-client": "5.4.0",
    "body-parser": "1.20.6",
    "express": "4.22.2",
    "image-size": "2.0.2",
    "meshcentral": "file:dist/meshcentral-1.2.5.tgz",
    "mongodb": "4.17.2"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "clean-css": "5.3.3",
    "esprima": "4.0.1",
    "html-minifier-terser": "7.2.0",
    "jsdom": "22.1.0",
    "terser": "5.51.2",
    "uglify-js": "3.19.3"
  }
}
