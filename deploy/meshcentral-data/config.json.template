{
  "settings": {
    "__comment__": "Starting config for a local development server (scripts/setup-local). Replace the mesh.example.com placeholders. Settings marked local development only must not reach a production config.",
    "Cert": "mesh.example.com",
    "Port": 3000,
    "RedirPort": 0,
    "TlsOffload": true,
    "TrustedProxy": ["127.0.0.1", "::1"],
    "CookieIpCheck": false,
    "AliasPort": 443,
    "AllowLoginToken": true,
    "AllowFraming": false,
    "MongoDb": null,
    "agentPort": 4449,
    "agentPortBind": "127.0.0.1",
    "agentAliasPort": 4445,
    "agentAliasDNS": "agents.mesh.example.com",
    "agentPortTls": true,
    "relayPort": 4450,
    "relayAliasPort": 4446,
    "agentUpdateSystem": 1,
    "plugins": {
      "enabled": true,
      "list": ["nativeruntime"]
    }
  },
  "domains": {
    "": {
      "__comment__": "NewAccounts: true lets anyone create an account from the login page. It is local development only.",
      "Title": "MeshCentral",
      "NewAccounts": true,
      "Auth": "default",
      "UserNameIsEmail": false
    }
  }
}
